{
    "name": "maxitsa/app",
    "autoload": {
        "psr-4": {
            "MAXITSA\\ENTITY\\": "src/entity/",
            "MAXITSA\\REPOSITORY\\": "src/repository/",
            "MAXITSA\\CONTOLLER\\": "src/controller/",
            "MAXITSA\\SERVICE\\": "src/service/",
            "APP\\CORE\\": "app/core/",
            "APP\\CORE\\ABSTRACT\\": "app/core/abstract/",
            "APP\\CORE\\MIDDLEWARE\\": "app/core/middlewares/",
            "APP\\CORE\\ENUM\\": "app/core/enum/"
        }
    },
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "twilio/sdk": "^8.6"
    },
    "scripts" : {
        "database:migrate" : "php /var/www/html/migrations/migration.php",
        "database:seed" : "php /var/www/html/seeders/seeder.php"
    }
}
